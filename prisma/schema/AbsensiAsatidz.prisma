model AbsensiAsatidz {
  id_absensi      Int             @id @default(autoincrement())
  user_id         Int
  tanggal_absensi DateTime        @default(now())
  status          StatusKehadiran
  keterangan      String?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @default(now()) @updatedAt
  User            User            @relation(fields: [user_id], references: [id_user])

  @@map("absensi_asatidz")
}

enum StatusKehadiran {
  HADIR
  IZIN
  SAKIT
  ALFA
  TERLAMBAT
}
