model Halaqah {
  id_halaqah   Int          @id(map: "halaqah_pkey") @default(autoincrement())
  name_halaqah String
  muhafiz_id   Int          @unique(map: "halaqah_muhafiz_id_key")
  deleted_at   DateTime?    @db.Timestamptz(6)
  jenis        JenisHalaqah @default(TAHFIDZ)
  User         User         @relation(fields: [muhafiz_id], references: [id_user], map: "halaqah_muhafiz_id_fkey")
  santri       Santri[]
}

enum JenisHalaqah {
  TAHFIDZ
  BACAAN
}
