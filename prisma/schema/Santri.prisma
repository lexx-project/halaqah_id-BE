enum KategoriTarget {
    RINGAN
    SEDANG
    INTENSE
}

model Santri {
    id_santri Int @id @default(autoincrement())
    nama_santri String
    nomor_telepon String?
    target KategoriTarget @default(RINGAN)

    halaqah_id Int
    halaqah  Halaqah @relation(fields: [halaqah_id], references: [id_halaqah])

// absensi Absensi[]
// setoran Setoran[]

deleted_at DateTime?
    @@map("santri")
}