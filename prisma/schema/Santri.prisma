model Santri {
  id_santri     Int            @id(map: "santri_pkey") @default(autoincrement())
  nama_santri   String
  target        KategoriTarget @default(RINGAN)
  halaqah_id    Int
  nomor_telepon String?
  deleted_at    DateTime?      @db.Timestamptz(6)
  Absensi       Absensi[]
  halaqah       Halaqah        @relation(fields: [halaqah_id], references: [id_halaqah], map: "santri_halaqah_id_fkey")
  Setoran       Setoran[]

  @@index([halaqah_id], map: "santri_halaqah_id_idx")
}

enum KategoriTarget {
  RINGAN
  SEDANG
  INTENSE
  KHUSUS
  BACAAN
}
