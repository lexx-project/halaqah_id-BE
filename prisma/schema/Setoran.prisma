model Setoran {
  id_setoran      Int              @id(map: "setoran_pkey") @default(autoincrement())
  santri_id       Int
  tanggal_setoran DateTime?        @default(now()) @db.Timestamptz(6)
  juz             Int
  surat           String
  ayat            String
  kategori        KategoriSetoran? @default(HAFALAN)
  taqwim          String?
  keterangan      String?
  Santri          Santri           @relation(fields: [santri_id], references: [id_santri], onDelete: Cascade, onUpdate: NoAction, map: "setoran_santri_id_fkey")
}

enum KategoriSetoran {
  HAFALAN
  MURAJAAH
  INTENS
  BACAAN
}
