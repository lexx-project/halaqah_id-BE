model Halaqah {
  id_halaqah   Int    @id @default(autoincrement())
  name_halaqah String

  muhafiz_id Int  @unique
  muhafiz    User @relation(fields: [muhafiz_id], references: [id_user])

  santri Santri[]

  deleted_at DateTime?

  @@map("halaqah")
}

enum KategoriTarget {
  RINGAN
  SEDANG
  INTENSE
}

model Santri {
  id_santri     Int            @id @default(autoincrement())
  nama_santri   String
  nomor_telepon String?
  target        KategoriTarget @default(RINGAN)

  halaqah_id Int
  halaqah    Halaqah @relation(fields: [halaqah_id], references: [id_halaqah])

  // absensi Absensi[]
  setoran Setoran[]

  deleted_at DateTime?

  @@map("santri")
}

enum KategoriSetoran {
  HAFALAN
  MURAJAAH
}

model Setoran {
  id_setoran Int    @id @default(autoincrement())
  santri_id  Int
  santri     Santri @relation(fields: [santri_id], references: [id_santri])

  tanggal_setoran DateTime        @default(now())
  juz             Int
  surat           String
  ayat            String
  kategori        KategoriSetoran @default(HAFALAN)
  taqwim          String?
  keterangan      String?

  @@map("setoran")
}

model User {
  id_user  Int      @id @default(autoincrement())
  username String   @unique
  email    String   @unique
  password String
  role     String   @default("muhafiz")
  halaqah  Halaqah?

  deleted_at DateTime?

  @@map("user")
}

